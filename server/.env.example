PORT=5000
NODE_ENV=development

# Database (Supabase PostgreSQL)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Service URLs
# In development: http://localhost:5000 & http://localhost:5173
# In production: Set to your live Render backend URL & Vercel frontend URL
BASE_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173

# Analytics & Fast Counters (Redis)
# Supports Upstash REST Redis (https://...) with REDIS_TOKEN
# Or standard TCP Redis (redis://default:password@host:port)
REDIS_URL=https://your-upstash-instance.upstash.io
REDIS_TOKEN=your_upstash_rest_token
